/**
 * audio_pipeline — ASR → LLM → TTS 音频对话调度（交互式多轮对话）
 *
 * 构建：
 *   mkdir build && cd build
 *   cmake .. -DCMAKE_BUILD_TYPE=Release
 *   make -j$(nproc)
 *
 * 运行：
 *   ./audio_pipeline            # 交互式多轮
 *   ./audio_pipeline "你好"     # 单发
 */

